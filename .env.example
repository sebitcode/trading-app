APP_ENV=development
TRADING_DB_PATH=data/trading.db
PAPER_TRADING_ONLY=true
MAX_ORDER_NOTIONAL=1000
MAX_OPERATION_LOSS=25
MAX_DAILY_LOSS=100
MAX_LEVERAGE=3
MAX_OPEN_OPERATIONS=10
MAX_SIGNAL_AGE_SECONDS=30
# Freshness window for server-recorded execution-plan read receipts.
EXECUTION_PLAN_READ_FRESHNESS_SECONDS=300
DEFAULT_FEE_RATE=0.001
# Per-side paper slippage used by risk estimates and simulated outcomes.
DEFAULT_SLIPPAGE_RATE=0.0002
HTTP_TIMEOUT_SECONDS=10
BINANCE_MARKET_DATA_ENABLED=true
BINANCE_SPOT_BASE_URL=https://data-api.binance.vision
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
# Public aggregate USDⓈ-M positioning context used by strategies.
BINANCE_POSITIONING_PERIOD=5m
BINANCE_POSITIONING_LIMIT=30
NEWS_RSS_FEEDS=https://cointelegraph.com/rss
# Optional global source; disabled by default to avoid accidental API quota usage.
CRYPTOPANIC_API_ENABLED=false
CRYPTOPANIC_AUTH_TOKEN=
CRYPTOPANIC_API_PLAN=growth
# Disabled by default; RSS is the free primary news source.
X_API_ENABLED=false
X_API_BASE_URL=https://api.x.com
# Used only by legacy/local process configuration. Authenticated accounts store their own X credentials.
X_BEARER_TOKEN=
X_INFLUENCER_USERNAMES=
TELEGRAM_API_BASE_URL=https://api.telegram.org
ACCOUNT_BOOTSTRAP_TOKEN=
# Generate with: uv run python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
CREDENTIAL_ENCRYPTION_KEY=
DEFAULT_ACCOUNT_ID=acct_local
MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*,testserver,testserver:*
MCP_ALLOWED_ORIGINS=
