# Copy this file to .env.compose, fill the required secrets, then run:
# docker compose --env-file .env.compose up --build -d

APP_ENV=production
APP_PORT=8000

# Generate a long random value; it is required to create the first account.
ACCOUNT_BOOTSTRAP_TOKEN=

# Generate with:
# uv run python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
CREDENTIAL_ENCRYPTION_KEY=

# Adjust these when the service is exposed beyond localhost.
MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*
MCP_ALLOWED_ORIGINS=
